# =============================================================================
# AI Dermatologist - backend environment template
# =============================================================================
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored. THIS FILE MUST NEVER CONTAIN A REAL SECRET.
#
# Only DATABASE_URL and JWT_SECRET are strictly required to boot; everything
# else has a working default (shown as the commented-out value).
# =============================================================================

# -----------------------------------------------------------------------------
# CORE
# -----------------------------------------------------------------------------
# Which config class to load: development | testing | production
APP_ENV=development

# REQUIRED. PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_derma_db

# REQUIRED IN PRODUCTION. HS256 signing key for access tokens.
# ProductionConfig REFUSES TO BOOT if this is unset, shorter than 32 chars, or
# still equal to the old committed default
# "AI_Derma_Super_Secret_Key_9988_Strong_And_Secure_2026".
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string

# Legacy alias kept only because the old .env had it. Nothing reads it.
# JWT_SECRET_KEY=

# -----------------------------------------------------------------------------
# TOKENS / AUTH
# -----------------------------------------------------------------------------
# Access token lifetime. Stays 24 until the frontend has a refresh timer;
# the drop to 2 is a deliberate, separate change.
# ACCESS_TOKEN_HOURS=24
# Opaque rotating refresh tokens (sha256 at rest, rotated on every use).
# REFRESH_TOKEN_DAYS=30

# Server-side password floor: min length, not all-numeric, not a common password.
# Applied where a password is CHOSEN (register / reset), never to an existing one.
# PASSWORD_MIN_LENGTH=8
# ...also on the two LEGACY routes (/register, /reset-password). A policy the old
# endpoint can bypass is not a policy. Set false to restore "anything goes".
# ENFORCE_PASSWORD_POLICY_LEGACY=true

# A successful password reset bumps users.token_version and revokes every refresh
# row, so a session stolen BEFORE the reset cannot outlive it.
# REVOKE_SESSIONS_ON_PASSWORD_RESET=true

# Reject an access token whose `tv` claim is behind users.token_version, which is
# what makes /auth/logout-all and admin suspension effective immediately.
# A MISSING `tv` counts as 0, so tokens minted before this feature still work.
# ENFORCE_SESSION_VERSION=true

# 403 doctors whose licence is not 'approved', on WRITE routes only.
# ON by default: migration 8a1c4b0d55e2 auto-approved every doctor who existed
# before enforcement, so this only ever affects doctors who register from now on.
# Read routes stay open -- a pending doctor must still see their own dashboard
# and the pending-verification screen.
# ENFORCE_DOCTOR_VERIFICATION=true

# Admin "act as user" delegation via the X-Act-As-User-Id header.
# Every use writes an audit_logs row. Requires Permission.ACTOR_ACT_AS,
# a STRICTLY higher role rank than the target, and refuses is_root targets.
# ALLOW_ACT_AS=true

# -----------------------------------------------------------------------------
# ROOT ADMIN SEED  (consumed by `flask seed-root` only)
# -----------------------------------------------------------------------------
# is_root can NEVER be set over HTTP. This CLI is the only path to it.
# The password must be at least 12 characters or the seed refuses to run.
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=use-at-least-12-characters
ROOT_ADMIN_NAME=Root Administrator

# -----------------------------------------------------------------------------
# DEMO SEED  (consumed by `flask seed-demo` -- dev only, never production)
# -----------------------------------------------------------------------------
# DEMO_PASSWORD=DemoPass123!
# DEMO_DOCTOR_EMAIL=demo.doctor@aiderma.local
# DEMO_PATIENT_EMAIL=demo.patient@aiderma.local

# -----------------------------------------------------------------------------
# EMAIL (OTP delivery, appointment notifications)
# -----------------------------------------------------------------------------
# Gmail requires an APP PASSWORD, not the account password.
# When these are blank, send_email() logs an error and returns False; /register
# then rolls back and returns 500, so signup will not work.
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# EMAIL_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# OTP POLICY
# -----------------------------------------------------------------------------
# OTP_EXPIRY_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=45

# -----------------------------------------------------------------------------
# GEMINI (the /api/chat assistant)
# -----------------------------------------------------------------------------
# Missing key => /api/chat returns 500 "Service currently unavailable".
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_OUTPUT_TOKENS=800

# -----------------------------------------------------------------------------
# ML MODEL
# -----------------------------------------------------------------------------
# MODEL_WEIGHTS_PATH=skindisease_best_model.weights.h5
# Load TensorFlow at boot instead of on the first /predict. Costs several
# seconds of startup; the monolith did this and died if the file was missing.
# EAGER_MODEL_LOAD=false

# -----------------------------------------------------------------------------
# SCHEDULER
# -----------------------------------------------------------------------------
# The SLA conflict auto-resolve job. MUST run in EXACTLY ONE process --
# the monolith started it at import, so `gunicorn -w 4` ran it four times and
# emailed both patients repeatedly. run.py sets this automatically for dev.
# RUN_SCHEDULER=false
# CONFLICT_SLA_HOURS=4
# CONFLICT_SLA_JOB_MINUTES=15

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# "*" reproduces the monolith's wide-open CORS(app). In production set an
# explicit comma-separated origin list.
# CORS_ORIGINS=*
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# CORS_SUPPORTS_CREDENTIALS=false

# -----------------------------------------------------------------------------
# RATE LIMITING (off in dev/test, ON in production -- the monolith had none)
# -----------------------------------------------------------------------------
# Two independent windows per auth endpoint: per-IP (one machine) and per-EMAIL
# (one account, which is the only one that survives a rotating IP pool). Budgets
# and rationale: app/core/rate_limit.py, table in docs/api-contract.md.
# A 429 is the JSON envelope plus a Retry-After header.
# RATELIMIT_ENABLED=false
# memory:// is PER PROCESS: under gunicorn with N workers the real budget is N x
# the documented one, and a restart forgets every counter. Use redis for a real
# limit rather than a speed bump.
# RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# RATELIMIT_DEFAULT=600 per hour

# -----------------------------------------------------------------------------
# ERRORS / LOGGING
# -----------------------------------------------------------------------------
# Emit the JSON envelope for 404/405/413/500 instead of Werkzeug's HTML pages.
# Set to false to restore the monolith's exact (HTML) error behaviour.
# JSON_ERROR_RESPONSES=true
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# -----------------------------------------------------------------------------
# DATABASE POOL / MISC
# -----------------------------------------------------------------------------
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# SQLALCHEMY_ECHO=false

# DANGER: creates tables from the models, bypassing Alembic. Test fixtures only.
# Leaving this on is how schema drift comes back.
# AUTO_CREATE_ALL=false

# Separate database for pytest. Falls back to DATABASE_URL when unset --
# BE CAREFUL, the test fixture drops and recreates every table it uses.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_derma_test

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=5000
# FLASK_DEBUG=1
